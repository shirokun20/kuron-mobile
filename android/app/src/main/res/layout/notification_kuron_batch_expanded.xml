<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_batch_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Row 1: Mascot Avatar + Queue Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Kuron Courier Avatar with Framed Squircle Background -->
        <ImageView
            android:id="@+id/batch_avatar_img"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/kuron_notif_avatar_bg"
            android:padding="3dp"
            android:src="@drawable/kuro_reader"
            android:scaleType="fitCenter"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null" />

        <!-- Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Speech Bubble Pill -->
            <TextView
                android:id="@+id/batch_speech_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/kuron_notif_speech_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="🐾 Kuron: 3 chapters loaded! Packing Ch. 12~"
                android:textColor="@color/notif_text_primary"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <!-- Active Chapter Title -->
            <TextView
                android:id="@+id/batch_active_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[Active 1/3] The Honor Student - Ch. 12"
                android:textColor="@color/notif_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/batch_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:max="100"
                android:progress="42"
                android:progressDrawable="@drawable/kuron_notif_progress" />

            <!-- Total Queue Stats -->
            <TextView
                android:id="@+id/batch_queue_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Queue: 48/136 pgs • 42.8/112 MB • ~45s left"
                android:textColor="@color/notif_text_secondary"
                android:textSize="10.5sp"
                android:singleLine="true" />

            <!-- Up Next Hint -->
            <TextView
                android:id="@+id/batch_up_next_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Up next: Ch. 13 (44 pgs) • Ch. 14 (50 pgs)"
                android:textColor="@color/notif_text_secondary"
                android:textSize="9.5sp"
                android:layout_marginTop="2dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 2: Action Buttons Row (Evenly weighted for phone & tablet) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_batch_pause"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/kuron_notif_btn_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Pause All"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_batch_cancel"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/kuron_notif_btn_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="Cancel All"
            android:textColor="@color/notif_btn_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_batch_view_queue"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:stateListAnimator="@null"
            android:background="@drawable/kuron_notif_btn_primary_bg"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:text="View Queue"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
